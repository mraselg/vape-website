# Apache (XAMPP) rules — PHP built-in server uses router.php instead.
Options -Indexes

# Block internal data
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(data|lib|includes|scratch)/ - [F,L]
# Canonical clean root redirect for index.php (301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s+/index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Force trailing slash on /admin
RewriteRule ^admin$ /admin/ [R=301,L]

# Legacy static URLs -> PHP (301)
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^category\.html$ category.php [R=301,L,QSA]
RewriteRule ^product\.html$ product.php [R=301,L,QSA]
</IfModule>

# Deny dotfiles
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
